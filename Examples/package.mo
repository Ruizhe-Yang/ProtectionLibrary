within ProtectionLibrary;
package Examples "Connected examples of criteria, voting and physical protection"
  extends Modelica.Icons.ExamplesPackage;
  annotation(Documentation(info="<html><p>Nine examples demonstrate threshold qualification, reset logic, voting, command authority, physical actions and independent action feedback. Each contains its sources, connections and stored experiment settings.</p><p>Begin with <a href=\"modelica://ProtectionLibrary.Examples.ThresholdLatchReset\">ThresholdLatchReset</a>, then choose an example for the required physical or signal interface.</p></html>"));
end Examples;
