within ProtectionLibrary.UsersGuide;
class Overview "Protection components and package organisation"
  extends Modelica.Icons.Information;
  annotation(Documentation(info="<html><p>ProtectionLibrary provides reusable criteria, Boolean and analogue voting, command coordination, physical protective devices and action monitoring for Modelica models.</p><p>Criteria generates requests; Voting combines channels; Coordination selects, retains or qualifies commands. Electrical, Mechanics, Thermal and Fluid contain both physical devices and domain-specific signal blocks. Connect a suitable action to the model and observe its response explicitly.</p></html>"));
end Overview;
