within ProtectionLibrary.UsersGuide;
class GettingStarted "Load the library and inspect a threshold-to-reset chain"
  extends Modelica.Icons.Information;
  annotation(Documentation(info="<html><p>Load Modelica 4.0.0, then open ProtectionLibrary/package.mo. Open <a href=\"modelica://ProtectionLibrary.Examples.ThresholdLatchReset\">Examples.ThresholdLatchReset</a> and use its stored 0–6 s experiment.</p><p>Plot signal.y, limit.request, persist.request, safeDwell.resetAllowed and protectedState. Then use <a href=\"modelica://ProtectionLibrary.Examples.ActionFeedbackAndFailure\">ActionFeedbackAndFailure</a> to compare commands with independent actuator feedback.</p></html>"));
end GettingStarted;
